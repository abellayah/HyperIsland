<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:id="@+id/layoutBatteryNotch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/enc_style_1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBatteryBolt"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_centerVertical="true"
                android:contentDescription="@null"
                android:src="@drawable/ic_hyper_bolt" />

            <TextView
                android:id="@+id/tvChargingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/ivBatteryBolt"
                android:ellipsize="marquee"
                android:fontFamily="sans-serif-bold"
                android:singleLine="true"
                android:text="Mi Turbo Charge"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBatteryPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toStartOf="@id/state_ic_c"
                android:fontFamily="sans-serif-black"
                android:singleLine="true"
                android:text="85%"
                android:textColor="#ff6edea4"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/state_ic_c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/pbBattery"
                    style="?android:progressBarStyleHorizontal"
                    android:layout_width="26dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="1dp"
                    android:max="100"
                    android:progress="85"
                    android:progressDrawable="@drawable/battery_progressbar" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="6dp"
                    android:background="#cb3f8733" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/layoutDefaultNotch"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/enc_style_1"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardIconBg"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivNotchIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_hyper_notification" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/textContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@id/rightWidgetContainer"
                android:layout_toEndOf="@id/cardIconBg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNotchTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="WhatsApp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvNotchSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:maxWidth="160dp"
                    android:text="Pesan baru masuk..."
                    android:textColor="@color/dnotch_text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rightWidgetContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotchBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/enc_style_1"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="4dp"
                    android:text="1"
                    android:textColor="#ff6edea4"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <com.hyperos.dynamicnotif.view.EqualizerView
                    android:id="@+id/notchEqualizer"
                    android:layout_width="16dp"
                    android:layout_height="14dp"
                    android:visibility="gone" />
            </LinearLayout>
        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
